<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-inherit="account_reports.AccountReportCustomizable" t-inherit-mode="extension">
        <xpath expr="//div[@id='reportFilterCollapse']/div" position="inside">
            <button
                class="btn btn-secondary o_account_reset_filter"
                t-on-click="() => this.filterReset()">
                    <i class="oi me-1" data-icon="undo"/>Reset
            </button>
        </xpath>
    </t>
</templates>
